# User Pool > Overview: issuer URL without a trailing slash.
VITE_COGNITO_ISSUER=https://cognito-idp.eu-central-1.amazonaws.com/eu-central-1_Example
# User Pool > App integration > App clients: public client ID.
VITE_COGNITO_CLIENT_ID=your_public_app_client_id
# User Pool > Managed login > Domain: include https://, no trailing slash.
VITE_COGNITO_DOMAIN=https://your-domain.auth.eu-central-1.amazoncognito.com
# These must exactly match Cognito callback and sign-out URLs.
VITE_REDIRECT_URI=http://localhost:5173
VITE_LOGOUT_URI=http://localhost:5173
# Optional protected API Gateway route.
VITE_API_URL=https://example.execute-api.eu-central-1.amazonaws.com/hello
